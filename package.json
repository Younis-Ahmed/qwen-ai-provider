{
  "name": "qwen-ai-provider",
  "version": "1.0.0",
  "packageManager": "pnpm@10.2.0",
  "description": "Vercel AI Provider for running Qwen AI models",
  "author": "Younis Ahmed <07430e0e-29c0-4a43-bcd0-c123714a124a@anonaddy.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Younis-Ahmed/qwen-ai-provider",
  "repository": {
    "type": "git",
    "url": "https://github.com/Younis-Ahmed/qwen-ai-provider"
  },
  "bugs": {
    "url": "https://github.com/Younis-Ahmed/qwen-ai-provider/issues"
  },
  "keywords": [
    "qwen",
    "ai",
    "provider",
    "vercel-ai",
    "vercel",
    "ai-sdk"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup -d --watch",
    "lint": "eslint \"./**/*.ts*\"",
    "test": "pnpm test:node && pnpm test:edge",
    "test:edge": "vitest --config vitest.edge.config.mjs --run",
    "test:node": "vitest --config vitest.node.config.mjs --run",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "prettier-check": "prettier --check \"./**/*.ts*\"",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "ci:release": "pnpm clean && pnpm build && npm publish --provenance --access public",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "dependencies": {
    "@ai-sdk/provider": "^2.0.5",
    "@ai-sdk/provider-utils": "^3.0.43"
  },
  "devDependencies": {
    "@ai-sdk/test-server": "^1.0.6",
    "@antfu/eslint-config": "^4.1.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@edge-runtime/vm": "^5.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9.19.0",
    "eslint-plugin-format": "^1.0.1",
    "husky": "^9.1.7",
    "msw": "^2.15.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "undici@<6.23.0": ">=6.23.0",
      "undici@<6.24.0": ">=6.24.0",
      "undici@<6.27.0": ">=6.27.0",
      "undici@<6.28.0": ">=6.28.0",
      "undici@<6.28.1": ">=6.28.1",
      "undici@>=4.0.0 <6.29.1": ">=6.29.1",
      "undici@>=4.2.1 <6.29.1": ">=6.29.1",
      "undici@>=5.15.0 <6.29.1": ">=6.29.1"
    }
  }
}
